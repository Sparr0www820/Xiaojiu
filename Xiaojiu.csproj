<Project Sdk="Godot.NET.Sdk/4.5.1">
    <PropertyGroup>
        <!-- 如果你安装了10.0并遇到问题，改下这里 -->
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>true</ImplicitUsings>
        <LangVersion>12.0</LangVersion>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <!-- 改成你的杀戮尖塔2目录 -->
        <Sts2Dir>F:\SteamLibrary\steamapps\common\Slay the Spire 2</Sts2Dir>
        <Sts2DataDir>$(Sts2Dir)\data_sts2_windows_x86_64</Sts2DataDir>
    </PropertyGroup>

    <ItemGroup>
        <Reference Include="sts2">
            <HintPath>$(Sts2DataDir)\sts2.dll</HintPath>
            <Private>false</Private>
        </Reference>

        <Reference Include="0Harmony">
            <HintPath>$(Sts2DataDir)\0Harmony.dll</HintPath>
            <Private>false</Private>
        </Reference>

        <PackageReference Include="STS2.RitsuLib" Version="0.2.31" />
    </ItemGroup>

    <ItemGroup>
      <Content Include="icon.svg" />
      <Content Include="README.md" />
      <Content Include="Xiaojiu\images\cards\Placeholder.png" />
      <Content Include="Xiaojiu\images\cards\Placeholder.png.import" />
      <Content Include="Xiaojiu\images\cards\TestCard.png" />
      <Content Include="Xiaojiu\images\cards\TestCard.png.import" />
      <Content Include="Xiaojiu\images\char_select_test.png" />
      <Content Include="Xiaojiu\images\char_select_test.png.import" />
      <Content Include="Xiaojiu\images\char_select_test_locked.png" />
      <Content Include="Xiaojiu\images\char_select_test_locked.png.import" />
      <Content Include="Xiaojiu\images\energy_test.png" />
      <Content Include="Xiaojiu\images\energy_test.png.import" />
      <Content Include="Xiaojiu\images\energy_test_big.png" />
      <Content Include="Xiaojiu\images\energy_test_big.png.import" />
      <Content Include="Xiaojiu\localization\zhs\ancients.json" />
      <Content Include="Xiaojiu\localization\zhs\cards.json" />
      <Content Include="Xiaojiu\localization\zhs\card_keywords.json" />
      <Content Include="Xiaojiu\localization\zhs\characters.json" />
      <Content Include="Xiaojiu\localization\zhs\powers.json" />
      <Content Include="Xiaojiu\scenes\test_bg.tscn" />
      <Content Include="Xiaojiu\scenes\test_character.tscn" />
      <Content Include="Xiaojiu\scenes\test_character_merchant.tscn" />
      <Content Include="Xiaojiu\scenes\test_character_rest_site.tscn" />
      <Content Include="Xiaojiu\scenes\test_energy_counter.tscn" />
      <Content Include="Xiaojiu.json" />
    </ItemGroup>

    <!-- 自动复制dll和json -->
    <Target Name="Copy Mod" AfterTargets="PostBuildEvent">
        <Message Text="Copying mod to Slay the Spire 2 mods folder..." Importance="high" />
        <MakeDir Directories="$(Sts2Dir)\mods\" />
        <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(Sts2Dir)\mods\$(MSBuildProjectName)\" />
        <Copy SourceFiles="$(MSBuildProjectName).json" DestinationFolder="$(Sts2Dir)/mods/$(MSBuildProjectName)/" />
    </Target>
</Project>
